# ============================================================
# MallBuddy backend — STAGING environment template (GAP-014)
# ============================================================
# Copy to `.env` inside the STAGING clone of this repo on the server
# (e.g. /root/mallbuddy-app/mallbuddy-backend-staging) and fill in real
# values. NEVER point staging at the production database.
#
# See docs/STAGING.md for the full setup runbook.

# --- Core ---
# Staging runs on its own port; nginx proxies staging-backend.mallbuddy.net → this port.
PORT=5001
# "staging" (not "production"): disables the Amwal renewal cron and
# production-only logging behavior while still being a deployed environment.
NODE_ENV=staging
# Cookies are cross-origin over HTTPS in staging too.
SECURE_COOKIES=true
USE_SAME_ORIGIN_COOKIES=false
LOG_LEVEL=debug

# --- Database (STAGING — e.g. a Neon branch of the prod DB, or a separate project) ---
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-HOST/neondb?sslmode=require

# --- Auth ---
# Use a DIFFERENT secret than production.
BETTER_AUTH_SECRET=generate-a-new-random-secret-for-staging
BETTER_AUTH_URL=https://staging-backend.mallbuddy.net

# --- CORS (staging admin web + local dev) ---
ALLOWED_ORIGINS=http://localhost:3000,https://staging-backend.mallbuddy.net,https://mallbuddy-web-app-staging.vercel.app
FRONTEND_URL=https://mallbuddy-web-app-staging.vercel.app

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- SMS / OTP (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
OTP_EXPIRY_MINUTES=5

# --- Amwal (keep pointing at the UAT/test gateway in staging) ---
AMWAL_MID=
AMWAL_TID=
AMWAL_SECURE_HASH=
AMWAL_API_URL=https://test.amwalpg.com
AMWAL_API_BASE_URL=https://test.amwalpg.com:14443
# Renewal cron stays off in staging (NODE_ENV !== production); flip only if needed:
AMWAL_RENEWAL_CRON_ENABLED=false
AMWAL_TEST_PAGE_ENABLED=true
