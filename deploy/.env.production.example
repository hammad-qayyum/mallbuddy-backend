# Copy to /opt/mallbuddy-backend/.env on the VPS and fill in real values.
NODE_ENV=production
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/mallbuddy"

BETTER_AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
BETTER_AUTH_URL="https://backend.mallbuddy.net"
SECURE_COOKIES=true

ALLOWED_ORIGINS="https://mallbuddy.net,https://www.mallbuddy.net"

# Optional — login OTP / email
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@mallbuddy.net
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Optional — Amwal payments
# AMWAL_MERCHANT_ID=
# AMWAL_TERMINAL_ID=
# AMWAL_SECURE_HASH=
# AMWAL_API_URL=
